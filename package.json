{
  "name": "stockmanager",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de gerenciamento de estoque",
  "workspaces": [
    "FrontEnd",
    "BackEnd"
  ],
  "scripts": {
    "dev": "concurrently -n BACK,FRONT -c blue,green \"npm:dev:back\" \"npm:dev:front\"",
    "dev:back": "npm run dev --workspace=BackEnd",
    "dev:front": "npm run dev --workspace=FrontEnd",
    "build": "npm run build --workspace=FrontEnd && npm run build --workspace=BackEnd",
    "prestart": "npm run build",
    "start": "npm run start --workspace=BackEnd",
    "typecheck": "npm run typecheck --workspace=BackEnd && npm run typecheck --workspace=FrontEnd",
    "prisma:generate": "npm run prisma:generate --workspace=BackEnd",
    "prisma:migrate": "npm run prisma:migrate --workspace=BackEnd",
    "prisma:studio": "npm run prisma:studio --workspace=BackEnd"
  },
  "keywords": [
    "node",
    "react",
    "express",
    "prisma",
    "postgresql",
    "estoque"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
